PORT=5000
MONGODB_URI=mongodb://localhost:27017/rasu
JWT_SECRET=your_jwt_secret_here

# Email SMTP Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# OTP disabled in development
# Set ENABLE_OTP=true to re-enable in production
ENABLE_OTP=false
